# ===== CoStage CE 部署配置（复制为 .env 后修改） =====

# 浏览器访问 LiveKit 信令的地址（签进 token，客户端据此连 WS；未走 nginx，直连 7880）
COSTAGE_LIVEKIT_URL=ws://192.168.1.10:7880

# LiveKit API Key secret（须与 configs/livekit.yaml 中 devkey 的 secret 一致）
LIVEKIT_SECRET=pocsecret

# TURN（可选：仅跨网段/严格 NAT 时需要；同网段可留空并在 compose 中删除 coturn 服务）
TURN_PASSWORD=turnpass
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
